# DeepSeek API Key (required if using DeepSeek provider)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Extra server-managed OpenAI-compatible providers (optional). A JSON array; each
# entry names the env var holding its key, so keys never sit inside the JSON:
#   id           lowercase id (not "deepseek", not starting with "custom-")
#   thinkingStyle  "enable_thinking" (DashScope/Qwen, SiliconFlow), "deepseek", or "none" (default)
#   models       model ids, or {"id","name"} objects; the first is the default
# Users can also add their own providers in the browser (Settings → 模型服务 → 添加);
# those always use the user's own key and never the server keys below.
# AI_PROVIDERS='[{"id":"bailian","name":"阿里云百炼","baseURL":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKeyEnv":"BAILIAN_API_KEY","models":["qwen3.7-plus","glm-5.2"],"thinkingStyle":"enable_thinking"}]'

# With docker-compose, also add each apiKeyEnv variable to the app's `environment:` list.
# Legacy shortcut: setting BAILIAN_API_KEY alone still registers 阿里云百炼 as a server provider.
# BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BAILIAN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Langfuse Observability (optional, tracing disabled if not set)
# Get keys from https://cloud.langfuse.com or your self-hosted instance
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_CAPTURE_CONTENT=false

# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU cloud (default)
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # US cloud

# Required encryption key: 64 hex characters. Generate once with openssl rand -hex 32.
# Keep it stable across deployments so saved browser credentials remain decryptable.
ENCRYPTION_KEY=

# Optional server-managed, automatically selected read-only demo connection.
# Keep its restricted account/password on the server. Visitors cannot edit/delete it.
DEMO_DB_ENABLED=false
DEMO_DB_NAME=电商演示库
DEMO_DB_HOST=
DEMO_DB_PORT=3306
DEMO_DB_USER=demo_readonly
DEMO_DB_PASSWORD=
DEMO_DB_DATABASE=

# Optional: preset a cloud database's public CA so visitors need not upload it.
# The CA is used ONLY for DB_SSL_CA_HOST, for both demo and personal connections.
# Paste the PEM certificate as a quoted value with escaped newlines (\n).
DB_SSL_CA_HOST=
DB_SSL_CA=

# Writes are disabled on the server by default. Production accounts must stay read-only.
# To allow a non-production target, BOTH settings below are required.
SQL_WRITE_ENABLED=false
SQL_WRITE_ALLOWLIST=
# SQL_WRITE_ALLOWLIST=dev-db:3306/DevelopmentDB

# Knowledge Q&A runs in-process (RAG over knowledge/kb-index.json) by default.
# Set KNOWLEDGE_BACKEND=remote to use the external service at MEMO_CHAT_API_BASE instead,
# which is resolved from inside the app container.
KNOWLEDGE_BACKEND=local
MEMO_CHAT_API_BASE=http://127.0.0.1:7860
# Optional: an index built from a private corpus, read at runtime instead of the bundled sample.
# KB_INDEX_PATH=/data/kb-index.json
# Embedding model used by `pnpm kb:ingest --embed` (server key of the provider is used).
# Query-time retrieval always uses the model recorded in the index.
# KB_EMBEDDING_PROVIDER=bailian
# KB_EMBEDDING_MODEL=text-embedding-v4
# KB_EMBEDDING_DIMENSIONS=512
# Vector hits below this cosine similarity are dropped.
# KB_MIN_SIMILARITY=0.3
# Limits for documents users upload to the knowledge base (stored in their own browser).
# KB_UPLOAD_MAX_DOCUMENTS=10
# KB_UPLOAD_MAX_BYTES=10485760
# KB_UPLOAD_MAX_CHARS=100000
# Optional Bocha web search for knowledge Q&A.
BOCHA_API_KEY=

# Compose binds to loopback by default. Put authenticated HTTPS proxy in front for a team.
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
